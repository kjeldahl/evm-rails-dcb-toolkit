<%# Plain semantic ERB, styled by the kit's classless stylesheet: a <table>
    needs no classes. Newest first, and an explicit empty state — a read
    model folds to its initial value for an entity with no events, which is
    a screen to render, never a 404. %>
<h1>Wallet <%= @wallet_id %></h1>

<p>
  Balance<br>
  <output><%= number_to_currency(@balance_cents / 100.0) %></output>
</p>

<h2>Activity</h2>

<% if @entries.empty? %>
  <p>No activity yet.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>When</th>
        <th>What</th>
        <th>Amount</th>
        <th>Balance</th>
      </tr>
    </thead>
    <tbody>
      <% @entries.reverse_each do |entry| %>
        <tr>
          <td><%= entry.at.utc.strftime("%Y-%m-%d %H:%M") %></td>
          <td><%= entry.kind %></td>
          <td><%= number_to_currency(entry.amount_cents / 100.0) %></td>
          <td><%= number_to_currency(entry.balance_cents / 100.0) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
